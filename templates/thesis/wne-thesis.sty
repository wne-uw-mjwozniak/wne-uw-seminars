% --- Title page (page 0, number not shown) -----------------------------------
\newcommand{\maketitlepage}{%
  \begin{titlepage}
    \setcounter{page}{0}% unique PDF destination; displayed numbering begins after the title
    \singlespacing\centering
    {\large \wne@university\par}
    \vspace{2mm}
    {\large \wne@faculty\par}
    \vspace{22mm}
    {\large \wne@author\par}
    \vspace{2mm}
    {\wne@albumlabel: \wne@album\par}
    \ifwne@pair
      \vspace{4mm}
      {\large \wne@secondauthor\par}
      {\wne@albumlabel: \wne@secondalbum\par}
    \fi
    \vspace{22mm}
    {\LARGE\bfseries \wne@title\par}
    \vspace{18mm}
    {\wne@kind\par}
    {\wne@fieldlabel: \wne@field\par}
    \vfill
    \hfill\begin{minipage}{0.55\textwidth}\raggedright
      \wne@supervisedby\\
      \wne@supervisor\\
      \wne@department
    \end{minipage}\par
    \vspace{22mm}
    {\wne@date\par}
  \end{titlepage}
  \setcounter{page}{1}%
}

% --- Declarations page -------------------------------------------------------
% \declarations            traditional thesis
% \declarations[article]   adds the statements on shares in the scientific article
\newcommand{\wne@signature}[1]{%
  \par\vspace{14mm}\noindent
  \makebox[0.35\textwidth][l]{\wne@datelabel\ \dotfill}\hfill
  \makebox[0.5\textwidth][l]{#1\ \dotfill}\par}

\newcommand{\declarations}[1][]{%
  \ifwne@pair\wne@pairdeclarations{#1}\else\wne@singledeclarations{#1}\fi
}
\newcommand{\wne@singledeclarations}[1]{%
  \clearpage
  \begingroup\singlespacing\setlength{\parindent}{0pt}\setlength{\parskip}{0.6\baselineskip}
  \def\wne@mode{#1}\def\wne@articlemode{article}%
  \ifwne@polish
    \def\wne@datelabel{Data}%
    {\bfseries Oświadczenie kierującego pracą\par}
    Oświadczam, że niniejsza praca została przygotowana pod moim kierunkiem i stwierdzam, że
    spełnia ona warunki do przedstawienia jej w postępowaniu o nadanie tytułu zawodowego.

    \ifx\wne@mode\wne@articlemode
      Oświadczam, że mój udział w artykule naukowym, który stanowi część pracy dyplomowej wynosi
      \makebox[12mm]{\dotfill}\%, zaś suplement do pracy został napisany samodzielnie przez
      dyplomanta(ów).
    \fi
    \wne@signature{Podpis kierującego pracą}

    \vspace{10mm}
    {\bfseries Oświadczenie autora pracy\par}
    Świadom odpowiedzialności prawnej oświadczam, że niniejsza praca dyplomowa została napisana
    przeze mnie samodzielnie i nie zawiera treści uzyskanych w sposób niezgodny z obowiązującymi
    przepisami.

    Oświadczam również, że przedstawiona praca nie była wcześniej przedmiotem procedur związanych
    z uzyskaniem tytułu zawodowego w wyższej uczelni.

    Oświadczam ponadto, że niniejsza wersja pracy jest identyczna z załączoną wersją elektroniczną.

    \ifx\wne@mode\wne@articlemode
      Oświadczam, że mój udział w artykule naukowym, który stanowi część pracy dyplomowej wynosi
      \makebox[12mm]{\dotfill}\% (nie mniej niż 60\%), zaś suplement do pracy został napisany
      przeze mnie.
    \fi
    \wne@signature{Podpis autora pracy}
  \else
    \def\wne@datelabel{Date}%
    {\bfseries Declaration of the supervisor\par}
    I declare that this thesis was prepared under my supervision and I confirm that it meets the
    requirements for submission in the procedure for awarding a professional degree.

    \ifx\wne@mode\wne@articlemode
      I declare that my share in the scientific article which forms part of this thesis is
      \makebox[12mm]{\dotfill}\%, and that the supplement was written independently by the
      student(s).
    \fi
    \wne@signature{Signature of the supervisor}

    \vspace{10mm}
    {\bfseries Declaration of the author\par}
    Aware of my legal responsibility, I declare that this thesis was written by me independently
    and does not contain content obtained in a manner inconsistent with applicable regulations.

    I also declare that this thesis has not previously been the subject of procedures for
    obtaining a professional degree at a higher education institution.

    Furthermore, I declare that this version of the thesis is identical to the attached
    electronic version.

    \ifx\wne@mode\wne@articlemode
      I declare that my share in the scientific article which forms part of this thesis is
      \makebox[12mm]{\dotfill}\% (not less than 60\%), and that the supplement was written by me.
    \fi
    \wne@signature{Signature of the author}
  \fi
  \endgroup
}

% A pair has one supervisor declaration and a separate declaration for each student.
% Contribution descriptions may run over more than one page.
\newcommand{\wne@pairdeclarations}[1]{%
  \ifx\wne@firstcontributions\@empty
    \PackageError{wne-thesis}{Missing first author's chapter contributions}%
      {Set authorcontributions in metadata.tex for both students.}\fi
  \ifx\wne@secondcontributions\@empty
    \PackageError{wne-thesis}{Missing second author's chapter contributions}%
      {Set authorcontributions in metadata.tex for both students.}\fi
  \clearpage
  \begingroup\singlespacing\setlength{\parindent}{0pt}\setlength{\parskip}{0.6\baselineskip}
  \def\wne@mode{#1}\def\wne@articlemode{article}%
  \ifwne@polish
    \def\wne@datelabel{Data}%
    {\bfseries Oświadczenie kierującego pracą\par}
    Oświadczam, że niniejsza praca została przygotowana pod moim kierunkiem i stwierdzam, że
    spełnia ona warunki do przedstawienia jej w postępowaniu o nadanie tytułu zawodowego.
    \ifx\wne@mode\wne@articlemode
      Oświadczam, że mój udział w artykule naukowym wynosi \makebox[12mm]{\dotfill}\%
      (nie więcej niż 20\%), zaś suplement został napisany samodzielnie przez dyplomantów.
      \par Mój wkład merytoryczny i procentowy w poszczególne części pracy:
    \fi
  \else
    \def\wne@datelabel{Date}%
    {\bfseries Declaration of the supervisor\par}
    I declare that this thesis was prepared under my supervision and meets the requirements
    for submission in the procedure for awarding a professional degree.
    \ifx\wne@mode\wne@articlemode
      My share in the scientific article is \makebox[12mm]{\dotfill}\% (at most 20\%).
      The supplement was written independently by \wne@author{} and \wne@secondauthor.
      \par My substantive and percentage contributions to each part of the thesis:
    \fi
  \fi
  \ifx\wne@mode\wne@articlemode
    \ifx\wne@supervisorcontributions\@empty
      \PackageError{wne-thesis}{Missing supervisor's article contributions}%
        {Set supervisorcontributions in metadata.tex, including zero shares in the supplement.}%
    \fi
    \wne@supervisorcontributions
  \fi
  \wne@signature{\ifwne@polish Podpis kierującego pracą\else Supervisor's signature\fi}
  \wne@pairauthor{\wne@author}{\wne@album}{\wne@firstcontributions}%
  \wne@pairauthor{\wne@secondauthor}{\wne@secondalbum}{\wne@secondcontributions}%
  \endgroup
}
\newcommand{\wne@pairauthor}[3]{%
  \clearpage
  {\bfseries\ifwne@polish Oświadczenie współautora pracy\else Declaration of a co-author\fi\par}
  #1, \wne@albumlabel: #2\par
  \ifwne@polish
    Mając świadomość odpowiedzialności prawnej, oświadczam, że mój wkład w niniejszą pracę został
    wykonany samodzielnie i nie zawiera treści uzyskanych w sposób niezgodny
    z obowiązującymi przepisami.
    \par Oświadczam, że przedstawiona praca nie była wcześniej przedmiotem procedur
    związanych z uzyskaniem tytułu zawodowego w wyższej uczelni oraz że niniejsza wersja
    pracy jest identyczna z załączoną wersją elektroniczną.
    \ifx\wne@mode\wne@articlemode
      \par Mój udział w artykule naukowym wynosi \makebox[12mm]{\dotfill}\% (nie mniej niż 40\%).
      Suplement napisaliśmy wspólnie jako współautorzy pracy,
      bez udziału promotora w autorstwie suplementu.
    \else
      \par Mój udział w pracy wynosi 50\%.
    \fi
    \par Mój wkład merytoryczny i procentowy w każdy rozdział pracy:
  \else
    Aware of my legal responsibility, I declare that I completed my contribution independently
    and that it contains no content obtained in a manner inconsistent with applicable regulations.
    \par I declare that this thesis has not previously been the subject of procedures for
    obtaining a professional degree at a higher education institution, and that this version
    is identical to the attached electronic version.
    \ifx\wne@mode\wne@articlemode
      \par My share in the scientific article is \makebox[12mm]{\dotfill}\% (not less than 40\%).
      The supplement was written jointly by \wne@author{} and \wne@secondauthor,
      without the supervisor as a co-author of the supplement.
    \else
      \par My share in the thesis is 50\%.
    \fi
    \par My substantive and percentage contributions to every chapter of the thesis:
  \fi
  #3
  \wne@signature{\ifwne@polish Podpis współautora\else Co-author's signature\fi}
}

% --- Declaration on the use of AI systems ------------------------------------
% \aideclaration{tool}{purpose}   or   \aideclaration{}{}  when no AI tool was used
\newcommand{\aideclaration}[2]{%
  \clearpage
  \begingroup\singlespacing\setlength{\parindent}{0pt}\setlength{\parskip}{0.6\baselineskip}
  \def\wne@tool{#1}%
  \ifwne@polish
    \def\wne@datelabel{Data}%
    {\bfseries Oświadczenie o wykorzystaniu w pracy systemów sztucznej inteligencji (SI)\par}
    \ifx\wne@tool\@empty
      Podczas przygotowania tej pracy autor/autorzy nie użyli żadnego narzędzia SI.
    \else
      Podczas przygotowania tej pracy autor/autorzy użyli #1 w celu #2. Autor/autorzy pracy
      dokonali weryfikacji treści i redakcji tekstu pracy zgodnie z jej założeniami, prezentują
      własny wkład intelektualny i biorą pełną odpowiedzialność za ostateczną postać pracy.
    \fi
    \wne@signature{Podpis Autora / Autorów}
  \else
    \def\wne@datelabel{Date}%
    {\bfseries Declaration on the use of artificial intelligence (AI) systems in the thesis\par}
    \ifx\wne@tool\@empty
      During the preparation of this thesis the author(s) did not use any AI tool.
    \else
      During the preparation of this thesis the author(s) used #1 in order to #2. The author(s)
      verified the content and edited the text in line with the aims of the thesis, present their
      own intellectual contribution and take full responsibility for the final form of the thesis.
    \fi
    \wne@signature{Signature of the author(s)}
  \fi
  \endgroup
}

% --- Abstract page -----------------------------------------------------------
\newcommand{\wne@abshead}[1]{\par\vspace{9mm}{\centering\bfseries #1\par}\vspace{3mm}}
\newcommand{\makeabstractpage}{%
  \clearpage
  \begingroup\singlespacing\setlength{\parindent}{0pt}
  \wne@abshead{\wne@abstractname}
  \wne@abstract\par
  \wne@abshead{\wne@keywordsname}
  {\centering \wne@keywords\par
   \ifx\wne@keywordspl\@empty\else(\wne@keywordspl)\par\fi}
  \wne@abshead{\wne@erasmusname}
  {\centering \wne@erasmus\par}
  \wne@abshead{\wne@classname}
  {\centering \wne@classification\par}
  \wne@abshead{\wne@alttitlename}
  {\centering \wne@titlealt\par}
  \endgroup
  \clearpage
}

% --- Separator cards for article-form theses (Załącznik B, point 17) ---------
\newcommand{\wne@card}[1]{\clearpage\phantomsection\addcontentsline{toc}{chapter}{#1}%
  \vspace*{\fill}{\centering\Huge\bfseries #1\par}\vspace*{\fill}\clearpage}
\newcommand{\articlecard}{\wne@card{\wne@articlecard}}
\newcommand{\supplementcard}{\wne@card{\wne@supplementcard}}

% \includearticle{basename}: PDF plus metadata from the same article build.
\newcount\wne@articleoffset
\newcommand{\WNEArticleEntry}[4]{%
  \addtocontents{#1}{\protect\contentsline{#2}{\unexpanded{\unexpanded{#3}}}%
    {\number\numexpr\wne@articleoffset+#4\relax}%
    {page.\number\numexpr\wne@articleoffset+#4\relax}}%
}
\newcommand{\WNEArticleCounters}[4]{%
  \setcounter{table}{#1}\setcounter{figure}{#2}%
  \setcounter{equation}{#3}\setcounter{footnote}{#4}%
}
\newcommand{\includearticle}[1]{%
  \IfFileExists{#1.pdf}{%
    \IfFileExists{#1.wne}{%
      \clearpage
      \wne@articleoffset=\numexpr\value{page}-1\relax
      \input{#1.wne}%
      \includepdf[pages=-,pagecommand={\thispagestyle{plain}}]{#1.pdf}%
    }{\PackageError{wne-thesis}{Article metadata not found: #1.wne}%
      {Build article-thesis.tex first. On Overleaf upload both its PDF and .wne file.}}%
  }{\PackageError{wne-thesis}{Article PDF not found: #1.pdf}%
    {Run make, or compile article-thesis.tex and upload its PDF and .wne file on Overleaf.}}%
}

% --- Lists at the end (point 15) ---------------------------------------------
\newcommand{\makelists}{%
  \clearpage
  \begingroup\let\clearpage\relax
  \listoftables
  \vspace{10mm}
  \listoffigures
  \endgroup
}

